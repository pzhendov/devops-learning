[Unit]
Description=Create a verified backup of the monitoring stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
ExecCondition=/usr/bin/test -x /home/ubuntu/bin/backup-monitoring
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/bin/backup-monitoring
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min